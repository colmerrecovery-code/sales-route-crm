# Backend
PORT=4000
DATABASE_URL=postgres://crm:crm@localhost:5432/sales_route_crm
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Routing engine (public OSRM demo is fine for development; self-host for production)
OSRM_URL=https://router.project-osrm.org
# Geocoding (Nominatim/OpenStreetMap; set a real contact for production use)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=sales-route-crm/1.0 (you@example.com)
CORS_ORIGIN=http://localhost:5173

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:4000/api
